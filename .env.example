# Copy this file to .env and replace the placeholders:  cp .env.example .env
# .env is gitignored. Never commit real secrets.
# Use letters and digits only in passwords (they are passed through shell commands).

# ---- Database -------------------------------------------------------------------------------
# The app works with any MySQL 8 server: the five DB_* values below say which one and how.
# On a new installation the app creates DB_NAME at its first start (when DB_USER may) and then
# all its tables; the MySQL user itself is never created by the app.

# Prod: which MySQL. "db" starts the MySQL container of compose.prod.yaml next to the app.
# For a MySQL server of your own, delete this line and set DB_HOST / DB_PORT below.
COMPOSE_PROFILES=db

# Prod: the MySQL server's address and port. Unset: the db container of the stack.
# With a server of your own, create its user once (as a MySQL administrator):
#   CREATE USER 'substance'@'%' IDENTIFIED BY '<DB_PASSWORD>';
#   GRANT ALL ON substance_tracker.* TO 'substance'@'%';
# DB_HOST=mysql.example.lan
# DB_PORT=3306

# Name of the application database. Dev also creates <DB_NAME>_test for the tests.
DB_NAME=substance_tracker

# Dev only, optional: the database the dev API uses instead of DB_NAME. Set it to
# substance_tracker_demo while building the frontend (see db/demo/reset-demo.sh in the README);
# remove it to go back to DB_NAME. The API tests keep using <DB_NAME>_test.
# API_DB_NAME=substance_tracker_demo

# MySQL user the API connects with.
DB_USER=substance

# Password of DB_USER. Required.
DB_PASSWORD=change-me-app-password

# Root password of the db container (with COMPOSE_PROFILES=db, and always in dev): it creates
# DB_NAME and DB_USER on its first start; healthcheck and backups use it too.
# Not needed with a MySQL server of your own.
MYSQL_ROOT_PASSWORD=change-me-root-password

# Dev only: host port for MySQL (for local DB tools). If 3306 is already taken on the host
# (e.g. a MySQL server running in WSL), pick another one such as 3307.
DB_HOST_PORT=3306

# Dev only: host port for the API (3000 inside the container; 3000 on the host is taken).
API_HOST_PORT=3001

# Dev only: host port for the Angular dev server.
WEB_HOST_PORT=4200

# Prod only: host port of the app (API + Angular build).
APP_PORT=8080

# Prod only, required: the address the instance is opened at, as the browser sees it (scheme, host,
# port). The sign-in accepts requests from this origin only; cookies are Secure when it is https.
# Plain http works too (e.g. http://192.168.1.10:8080 on a home network).
APP_URL=http://localhost:8080

# Prod only, required: signs the session cookies. At least 32 characters: openssl rand -base64 32
AUTH_SECRET=change-me-to-a-long-random-secret-of-32-chars-or-more

# The first administrator, created at the first start; its password is written to
# to_delete.password.txt in this folder (delete it after reading). Unset: admin, in dev and in prod
# (lenzi, 2026-10-03). The username is permanent (3-30 characters: a-z, 0-9, - and _; not login,
# api, ...): its pages are /<username>, its admin panel /<username>/admin. A username that breaks
# these rules stops the start, and the log says why.
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.invalid

# Prod, optional: the published image to run (a26.0.0.0001, b26.1.0.0000, v26.1.2.0003: prefix,
# year, backend, frontend, four-digit build). Unset: the last release.
# APP_VERSION=

# Prod only, optional: the header your reverse proxy sets to the client's IP (e.g. x-forwarded-for,
# cf-connecting-ip, x-real-ip), used for the sign-in counters; its last value is taken. Leave it
# empty when nothing sits in front of the app: the connection's address is used.
CLIENT_IP_HEADER=

# API log level: fatal, error, warn, info, debug, trace.
LOG_LEVEL=info
